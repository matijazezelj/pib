{
  "uid": "pib-overview",
  "title": "PIB — PKI Certificate Health",
  "description": "Certificate expiry monitoring across all TLS endpoints",
  "tags": ["pib", "pki", "certificates", "security"],
  "refresh": "5m",
  "schemaVersion": 38,
  "version": 1,
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Expiring Critical",
      "description": "Certificates inside their critical window: CRITICAL_DAYS (default 7), capped at 1/10 of the certificate's lifetime so a 24 h cert is only critical in its last 2.4 h.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": []
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "pib-vm" },
        "expr": "last_over_time(pib_certs_expiring_critical[8h])",
        "legendFormat": "Critical",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Expiring Soon",
      "description": "Certificates inside their warning window: WARN_DAYS (default 30), capped at 1/3 of the certificate's lifetime.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "mappings": []
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "pib-vm" },
        "expr": "last_over_time(pib_certs_expiring_warning[8h])",
        "legendFormat": "Warning",
        "refId": "A"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Expired",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "dark-red", "value": 1 }
            ]
          },
          "mappings": []
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "pib-vm" },
        "expr": "last_over_time(pib_certs_expired[8h])",
        "legendFormat": "Expired",
        "refId": "A"
      }]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Unreachable",
      "description": "Configured endpoints that could not be checked this scan — their expiry countdown is stale.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "mappings": []
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "pib-vm" },
        "expr": "last_over_time(pib_certs_unreachable[8h])",
        "legendFormat": "Unreachable",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total Monitored",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "mappings": []
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "pib-vm" },
        "expr": "last_over_time(pib_certs_total[8h])",
        "legendFormat": "Certs",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Last Scan",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal",
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "mappings": []
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "pib-vm" },
        "expr": "last_over_time(pib_last_scan_timestamp[7d])",
        "legendFormat": "Last Scan",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Certificate Inventory",
      "description": "All monitored TLS certificates. Time remaining is counted from the expiry date, so it stays current between scans. Status uses the same lifetime-capped thresholds as the counters above. Rows from hosts or certificates that the last scan no longer saw are dropped; an unreachable host keeps its last known row.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 4 },
      "options": {
        "sortBy": [{ "displayName": "Time Remaining", "desc": false }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "displayMode": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "host" }, "properties": [{ "id": "displayName", "value": "Host" }] },
          { "matcher": { "id": "byName", "options": "cn" }, "properties": [{ "id": "displayName", "value": "Common Name" }] },
          { "matcher": { "id": "byName", "options": "issuer" }, "properties": [{ "id": "displayName", "value": "Issuer" }] },
          { "matcher": { "id": "byName", "options": "sans" }, "properties": [{ "id": "displayName", "value": "SANs" }] },
          {
            "matcher": { "id": "byName", "options": "Value #A" },
            "properties": [
              { "id": "displayName", "value": "Time Remaining" },
              { "id": "unit", "value": "dtdurations" },
              { "id": "custom.width", "value": 200 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #B" },
            "properties": [
              { "id": "displayName", "value": "Status" },
              { "id": "custom.width", "value": 140 },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [{ "type": "value", "options": {
                "0": { "text": "OK", "color": "green" },
                "1": { "text": "Expiring soon", "color": "orange" },
                "2": { "text": "Critical", "color": "red" },
                "3": { "text": "Expired", "color": "dark-red" }
              }}]}
            ]
          }
        ]
      },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true }, "indexByName": {}, "renameByName": {} } }
      ],
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "pib-vm" },
          "expr": "(last_over_time(pib_cert_expiry_timestamp[8h]) / 1000 - time()) and on(host, cn, issuer, sans) (tlast_over_time(pib_cert_expiry_timestamp[8h]) > (scalar(last_over_time(pib_last_scan_timestamp[8h])) / 1000 - 60)) or (last_over_time(pib_cert_expiry_timestamp[8h]) / 1000 - time()) and on(host) (last_over_time(pib_cert_check_success[8h]) == 0 and tlast_over_time(pib_cert_check_success[8h]) > (scalar(last_over_time(pib_last_scan_timestamp[8h])) / 1000 - 60))",
          "instant": true,
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "pib-vm" },
          "expr": "last_over_time(pib_cert_status[8h]) and on(host, cn, issuer, sans) (tlast_over_time(pib_cert_status[8h]) > (scalar(last_over_time(pib_last_scan_timestamp[8h])) / 1000 - 60)) or last_over_time(pib_cert_status[8h]) and on(host) (last_over_time(pib_cert_check_success[8h]) == 0 and tlast_over_time(pib_cert_check_success[8h]) > (scalar(last_over_time(pib_last_scan_timestamp[8h])) / 1000 - 60))",
          "instant": true,
          "format": "table",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Time Remaining Over Time",
      "description": "Certificate expiry countdown — watch for certs approaching zero",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "asc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 604800 },
              { "color": "yellow", "value": 2592000 },
              { "color": "green", "value": 5184000 }
            ]
          }
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "pib-vm" },
        "expr": "(last_over_time(pib_cert_expiry_timestamp[8h]) / 1000 - time()) and on(host, cn, issuer, sans) (tlast_over_time(pib_cert_expiry_timestamp[8h]) > (scalar(last_over_time(pib_last_scan_timestamp[8h])) / 1000 - 60)) or (last_over_time(pib_cert_expiry_timestamp[8h]) / 1000 - time()) and on(host) (last_over_time(pib_cert_check_success[8h]) == 0 and tlast_over_time(pib_cert_check_success[8h]) > (scalar(last_over_time(pib_last_scan_timestamp[8h])) / 1000 - 60))",
        "legendFormat": "{{host}} ({{cn}})",
        "refId": "A"
      }]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": []
}
