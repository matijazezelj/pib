# ============================================
# PIB (PKI in a Box) Configuration
# ============================================

# ==================== Grafana ====================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3005

# ==================== VictoriaMetrics ====================
VICTORIAMETRICS_PORT=8433
VICTORIAMETRICS_RETENTION=365d

# ==================== CA ====================
# Port step-ca listens on (ACME + API)
CA_PORT=9000
# Display name for the root CA
CA_NAME=My PKI Root CA
# DNS names the CA cert will be valid for (comma-separated)
CA_DNS_NAMES=localhost,pib-ca

# ==================== Monitor ====================
# Comma-separated host:port pairs to watch for cert expiry
# pib-ca:9000 is always included automatically
MONITOR_HOSTS=pib-ca:9000
SCAN_INTERVAL_HOURS=6
SCAN_ON_STARTUP=true
# Alert thresholds (days remaining)
WARN_DAYS=30
CRITICAL_DAYS=7
