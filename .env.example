# ============================================
# PIB (PKI in a Box) Configuration
# ============================================

# ==================== Grafana ====================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3005

# ==================== VictoriaMetrics ====================
VICTORIAMETRICS_PORT=8433
VICTORIAMETRICS_RETENTION=365d

# ==================== CA ====================
# Port step-ca listens on (ACME + API)
CA_PORT=9000
# Display name for the root CA
CA_NAME=My PKI Root CA
# DNS names the CA cert will be valid for (comma-separated)
CA_DNS_NAMES=localhost,pib-ca

# ==================== Monitor ====================
# Comma-separated host:port pairs to watch for cert expiry
MONITOR_HOSTS=pib-ca:9000
# Always prepended to MONITOR_HOSTS so you cannot accidentally stop
# watching your own CA. Set empty to opt out.
CA_HOST=pib-ca:9000
SCAN_INTERVAL_HOURS=6
SCAN_ON_STARTUP=true
# Alert thresholds (days remaining)
WARN_DAYS=30
CRITICAL_DAYS=7
# Thresholds for the CA's own root/intermediate. Much longer: replacing them
# means re-anchoring trust on every machine that trusts this CA.
CA_WARN_DAYS=365
CA_CRITICAL_DAYS=90

# ==================== Alerting ====================
# Alert rules are provisioned automatically and visible under Alerting in
# Grafana. To have them DELIVERED, set this and also:
#   cp grafana/provisioning/alerting/contactpoints.yaml.example \
#      grafana/provisioning/alerting/contactpoints.yaml
# Leaving it empty with that file active makes Grafana refuse to start.
ALERT_WEBHOOK_URL=

# Network exposure (127.0.0.1 is safe for local demos; set 0.0.0.0 for LAN exposure)
BIND_ADDR=127.0.0.1
